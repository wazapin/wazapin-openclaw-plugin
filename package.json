{
  "name": "@wazapin/openclaw-plugin",
  "version": "0.1.0",
  "description": "Wazapin WhatsApp channel plugin for OpenClaw — send/receive WhatsApp messages, manage channels, multi-org support.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "openclaw.plugin.json"
  ],
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "channel": {
      "id": "wazapin",
      "label": "Wazapin WhatsApp",
      "blurb": "Connect OpenClaw to WhatsApp via Wazapin."
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/channel.ts --format esm --dts --out-dir dist",
    "dev": "tsup src/index.ts src/channel.ts --format esm --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "openclaw": "2026.7.1-2"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsup": "^8.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wazapin/wazapin-openclaw-plugin"
  }
}
